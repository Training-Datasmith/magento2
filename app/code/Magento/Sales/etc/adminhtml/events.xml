<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_delete_before">
        <observer name="sales_quote_observer" instance="Magento\Sales\Observer\Backend\Subtract_Qty_From_Quotes_Observer" />
    </event>
    <event name="catalogrule_before_apply">
        <observer name="sales_quote_observer" instance="Magento\Sales\Observer\Backend\Catalog_Price_Rule" />
    </event>
    <event name="catalogrule_after_apply">
        <observer name="sales_quote_observer" instance="Magento\Sales\Observer\Backend\Catalog_Price_Rule" />
    </event>
    <event name="catalog_product_save_after">
        <observer name="sales_quote" instance="Magento\Sales\Observer\Backend\Catalog_Product_Save_After_Observer" />
    </event>
</config>
