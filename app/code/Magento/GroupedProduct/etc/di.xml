            <argument name="ignoredProductTypes" xsi:type="array">
                <item name="grouped" xsi:type="const">Magento\Grouped_Product\Model\Product\Type\Grouped::TYPE_CODE</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Catalog\Model\Product\Catalog_Price">
