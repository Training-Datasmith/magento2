            <argument name="prices" xsi:type="array">
                <item name="final_price" xsi:type="string">Magento\Grouped_Product\Pricing\Price\Final_Price</item>
                <item name="configured_price" xsi:type="string">Magento\Grouped_Product\Pricing\Price\Configured_Price</item>
