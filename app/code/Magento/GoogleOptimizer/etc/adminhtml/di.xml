<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Magento\Catalog\Ui\Data_Provider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="GoogleOptimizer" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Google_Optimizer\Ui\Data_Provider\Product\Form\Modifier\Google_Optimizer</item>
                    <item name="sortOrder" xsi:type="number">100</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Magento\Google_Optimizer\Block\Adminhtml\Form\Cms_Page" type="Magento\Google_Optimizer\Block\Adminhtml\Form">
        <arguments>
            <argument name="data" xsi:type="array">
