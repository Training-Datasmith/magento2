<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Ui\Data_Provider\Mapper\Form_Element">
        <arguments>
            <argument name="mappings" xsi:type="array">
                <item name="text" xsi:type="string">input</item>
                <item name="hidden" xsi:type="string">input</item>
                <item name="boolean" xsi:type="string">checkbox</item>
                <item name="media_image" xsi:type="string">image</item>
                <item name="price" xsi:type="string">input</item>
                <item name="weight" xsi:type="string">input</item>
                <item name="gallery" xsi:type="string">image</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Ui\Data_Provider\Mapper\Meta_Properties">
        <arguments>
            <argument name="mappings" xsi:type="array">
                <item name="dataType" xsi:type="string">frontend_input</item>
                <item name="visible" xsi:type="string">is_visible</item>
                <item name="required" xsi:type="string">is_required</item>
                <item name="label" xsi:type="string">frontend_label</item>
                <item name="sortOrder" xsi:type="string">sort_order</item>
                <item name="notice" xsi:type="string">note</item>
                <item name="default" xsi:type="string">default_value</item>
                <item name="size" xsi:type="string">multiline_count</item>
                <item name="scope" xsi:type="string">is_global</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Authorization\Model\Composite_User_Context">
        <arguments>
            <argument name="userContexts" xsi:type="array">
                <item name="adminSessionUserContext" xsi:type="array">
                    <item name="type" xsi:type="object">Magento\User\Model\Authorization\Admin_Session_User_Context</item>
                    <item name="sortOrder" xsi:type="string">30</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Ui\Model\Color_Picker\Color_Modes_Provider">
        <arguments>
            <argument name="colorModesPool" xsi:type="array">
                <item name="full" xsi:type="string">Magento\Ui\Model\Color_Picker\Full_Mode</item>
                <item name="simple" xsi:type="string">Magento\Ui\Model\Color_Picker\Simple_Mode</item>
                <item name="noalpha" xsi:type="string">Magento\Ui\Model\Color_Picker\No_Alpha_Mode</item>
                <item name="palette" xsi:type="string">Magento\Ui\Model\Color_Picker\Palette_Only_Mode</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Ui\Model\Url_Input\Links_Config_Provider">
        <arguments>
            <argument name="linksConfiguration" xsi:type="array">
                <item name="default" xsi:type="string">Magento\Ui\Model\Url_Input\Url</item>
            </argument>
        </arguments>
    </type>

    <!-- Plugin to automatically convert row1/row2/row3 format to numerically indexed arrays -->
    <type name="Magento\Config\Model\Config\Backend\Serialized\Array_Serialized">
        <plugin name="ui_array_serialized_plugin" type="Magento\Ui\Plugin\Config\Backend\Array_Serialized_Plugin" />
    </type>
</config>
