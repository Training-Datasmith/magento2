<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <uiComponent name="admin_usage_notification">
                <visibilityCondition name="can_view_admin_usage_notification" className="Magento\Admin_Analytics\Model\Condition\Can_View_Notification"/>
            </uiComponent>
            <block name="tracking_notification" as="tracking_notification" template="Magento_AdminAnalytics::notification.phtml">
                <arguments>
                    <argument name="notification" xsi:type="object">Magento\Admin_Analytics\View_Model\Notification</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
