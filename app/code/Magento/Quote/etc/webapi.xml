        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>
    <route url="/V1/carts/mine" method="PUT">
        <service class="Magento\Quote\Api\Cart_Repository_Interface" method="save"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="quote.id" force="true">%cart_id%</parameter>
        </data>
    </route>
    <route url="/V1/carts/mine/order" method="PUT">
        <service class="Magento\Quote\Api\Cart_Management_Interface" method="placeOrder"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%cart_id%</parameter>
        </data>
    </route>

