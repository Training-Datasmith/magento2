<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/queue.xsd">
    <broker topic="sales_rule.codegenerator" exchange="magento">
        <queue name="codegenerator" consumer="codegeneratorProcessor" handler="Magento\Sales_Rule\Model\Coupon\Consumer::process"/>
    </broker>
    <broker topic="sales.rule.update.coupon.usage" exchange="magento">
        <queue name="sales.rule.update.coupon.usage" consumer="sales.rule.update.coupon.usage" handler="Magento\Sales_Rule\Model\Coupon_Usage_Consumer::process"/>
    </broker>
    <broker topic="sales.rule.quote.trigger.recollect" exchange="magento">
        <queue name="sales.rule.quote.trigger.recollect" consumer="sales.rule.quote.trigger.recollect" handler="Magento\Sales_Rule\Model\Queue\Consumer\Rule_Quote_Recollect_Totals::process"/>
    </broker>
</config>
