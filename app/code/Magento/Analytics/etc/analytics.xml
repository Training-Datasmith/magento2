<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Analytics:etc/analytics.xsd">
    <file name="modules">
        <providers>
            <reportProvider name="modules" class="Magento\Analytics\Report_Xml\Report_Provider">
                <parameters>
                    <name>modules</name>
                </parameters>
            </reportProvider>
        </providers>
    </file>
    <file name="store_config">
        <providers>
            <customProvider name="store_config" class="Magento\Analytics\Model\Store_Configuration_Provider"/>
        </providers>
    </file>
    <file name="stores">
        <providers>
            <reportProvider name="stores" class="Magento\Analytics\Report_Xml\Report_Provider">
                <parameters>
                    <name>stores</name>
                </parameters>
            </reportProvider>
        </providers>
    </file>
    <file name="websites">
        <providers>
            <reportProvider name="websites" class="Magento\Analytics\Report_Xml\Report_Provider">
                <parameters>
                    <name>websites</name>
                </parameters>
            </reportProvider>
        </providers>
    </file>
    <file name="groups">
        <providers>
            <reportProvider name="groups" class="Magento\Analytics\Report_Xml\Report_Provider">
                <parameters>
                    <name>groups</name>
                </parameters>
            </reportProvider>
        </providers>
    </file>
</config>
